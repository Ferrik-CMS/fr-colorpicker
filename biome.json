{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"linter": {
		"enabled": true
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"javascript": {
		"formatter": {
			"indentStyle": "tab",
			"lineWidth": 120,
			"quoteStyle": "double"
		}
	},
	"css": {
		"formatter": {
			"enabled": true
		}
	}
}
